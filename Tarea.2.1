################# EJEMPLO FINAL ####################

songs = ["Like a Rolling Stone", "Satisfaction", "Imagine", "What's Going On", "Respect", "Good Vibrations"]  
# Lista de canciones

playcounts = [78, 29, 44, 21, 89, 5]  
# Lista con número de reproducciones

plays = {key:value for key, value in zip(songs, playcounts)}  
# Crea diccionario canción:reproducciones
print(plays)

plays.update({"Purple Haze": 1})  
# Agrega nueva canción con reproducciones

plays.update({"Respect": 94})  
# Modifica el valor de 'Respect'

print("After: ", plays)

library = {"The Best Songs": plays, "Sunday Feelings": {}}  
# Diccionario que contiene otros diccionarios (diccionario anidado)

print(library)  # Imprime toda la estructura